# SRM RMP OD Platform Environment Configuration

# Backend FastAPI Configuration
PROJECT_NAME="SRM RMP OD API"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production-environments"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/srm_od"

# CORS Configuration (Comma separated origins for web production)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# File Upload Storage Directory
UPLOAD_DIR="uploads"

# Environment Mode (development / staging / production)
ENVIRONMENT="development"

# Frontend Flutter Launch Command Example (for physical Android device on LAN):
# flutter run --dart-define=API_BASE_URL=http://192.168.1.10:8000/api/v1
